  "corroboration": [
    {
      "_comment": "Rebuild a category from figures the expert stated independently of the MIS, then compare. Uses no MIS input, so agreement tests the MIS rather than repeating it.",
      "name": "BPC from the expert's stated base and YoY",
      "method": "base_times_yoy",
      "base_label": "Personal care base",
      "base_key": "personal_care_sep25",
      "yoy_category": "Personal Care",
      "mis_category": "Personal Care"
    },
    {
      "name": "Men's casual wear from the price-point build-up",
      "method": "parts_over_share",
      "part_labels": [
        "Men's entry (₹0–500)",
        "Men's mass (₹501–1,000)"
      ],
      "share_label": "Men's entry + mass share",
      "mis_category": "Men's Casual Wear"
    }
  ],
  "output_layout": {
    "_comment": "Order of the exported upload sheet. Sections are matched against parent_question in order; the first match wins. Template order is preserved inside each section. Parameters with no value are moved to the end.",
    "nulls_last": true,
    "sections": [
      {
        "name": "Platform topline",
        "match": [
          "^GMV$",
          "^AOV$",
          "^Topline$",
          "^Other Topline Metrics$"
        ]
      },
      {
        "name": "Category shipped GMV",
        "match": [
          "^Category Shipped GMV"
        ]
      },
      {
        "name": "Category ASP",
        "match": [
          "^Category\\s+ASP"
        ]
      },
      {
        "name": "Category contribution",
        "match": [
          "^Category Shipped % GMV"
        ]
      },
      {
        "name": "Other calculated metrics",
        "match": [
          ".*"
        ]
      }
    ]
  },
  "residual_l2": {
    "_comment": "Decision Q1A: the MIS 17 categories are the full platform. These model L2s have no MIS line, so they are carved OUT of the MIS total at their historical share and the MIS categories scale down proportionally. Platform total is preserved.",
    "keys": [
      "watches",
      "fashion_acc"
    ],
    "policy": "carve_from_total"
  },
  "source_policy": {
    "_comment": "Decision Q2A / Q4A. mis_anchor = reported actual, never moved by weights. mis_record_only = captured for the audit trail but NOT used numerically because the unit definition conflicts with the model.",
    "shipped_gmv": "mis_anchor",
    "category_gmv": "mis_anchor",
    "category_asp": "mis_anchor",
    "returns_pct": "mis_anchor",
    "geo_split": "mis_anchor",
    "aov": "mis_record_only",
    "orders": "mis_record_only",
    "mtu": "mis_record_only",
    "gross_gmv": "derived",
    "cancellation_pct": "estimated",
    "basket_size": "estimated",
    "mau": "estimated",
    "mac": "estimated"
  },
  "mis_definition_conflicts": {
    "_comment": "Known unit-definition mismatches between the MIS and the model. Surfaced on every run; never silently applied.",
    "AOV at SP": {
      "model_metric": "aov",
      "note": "MIS AOV is consistent with MIS orders (orders x AOV = MIS shipped GMV) but sits ~47% below the model's order-level AOV. Reads as a shipment-level or item-weighted unit, not an order."
    },
    "Monthly Orders": {
      "model_metric": "gross_transactions",
      "note": "MIS orders exceed model gross transactions by ~50%. Same unit-definition issue as AOV."
    },
    "Monthly Transacting Users": {
      "model_metric": "mtu",
      "note": "MIS MTU of 80M exceeds even model MAU (~67M) and is ~5x model MTU. Reads as a registered-or-reached base, not transacting users."
    }
  },
  "plausibility_bounds": {
    "_comment": "Month-on-month moves beyond these raise a contradiction flag. They never silently clamp a value.",
    "cancellation_pct": {
      "max_abs_mom_delta": 0.04
    },
    "returns_pct": {
      "max_abs_mom_delta": 0.05
    },
    "metro_pct": {
      "max_abs_mom_delta": 0.05
    },
    "tier1_pct": {
      "max_abs_mom_delta": 0.05
    },
    "tier2plus_pct": {
      "max_abs_mom_delta": 0.05
    },
    "basket_size": {
      "max_abs_mom_delta": 0.3
    },
    "shipped_gmv": {
      "max_abs_mom_pct": 0.6
    }
  },
  "identities": {
    "_comment": "Checked after every run. Tolerance is relative unless the metric is a share.",
    "gross_from_shipped": {
      "expr": "gross_gmv * (1 - cancellation_pct) == shipped_gmv",
      "tol": 1e-06
    },
    "net_from_shipped": {
      "expr": "net_gmv == shipped_gmv * (1 - returns_pct)",
      "tol": 1e-06
    },
    "returns_split": {
      "expr": "returns_pct == rto_pct + rvp_pct",
      "tol": 1e-09
    },
    "segment_total": {
      "expr": "sum(segment.shipped_gmv) == shipped_gmv",
      "tol": 1e-06
    },
    "l2_total": {
      "expr": "sum(l2.gmv) == shipped_gmv",
      "tol": 1e-06
    },
    "payment_split": {
      "expr": "cod_pct + prepaid_pct == 1",
      "tol": 1e-09
    },
    "geo_split": {
      "expr": "metro_pct + tier1_pct + tier2plus_pct == 1",
      "tol": 1e-09
    },
    "contrib_shares": {
      "expr": "sum(l2.share) == 1",
      "tol": 1e-06
    }
  }
}